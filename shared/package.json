{
  "name": "@roomcraft/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contracts shared by the web app and the API: schema-generated types, catalog and fixtures.",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*",
    "./fixtures/*": "./fixtures/*",
    "./seed/*": "./seed/*"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  }
}
