# Copy to api/.env to override defaults locally. Every variable is optional.
# In local development the web app reaches the API through the Vite dev proxy,
# so CORS does not apply there.

# JSON list of exact origins allowed to call the API.
# ROOMCRAFT_CORS_ORIGINS=["https://roomcraft-planner.web.app","https://roomcraft-planner.firebaseapp.com"]

# Regex for further allowed origins. Defaults to Firebase Hosting preview channels.
# ROOMCRAFT_CORS_ORIGIN_REGEX=https://roomcraft-planner--[a-z0-9-]+\.web\.app
