# Copy to web/.env.local for local development. All variables are required.
# None of these are secrets: they are bundled into the public web app.

# Base URL of the API. web/.env.development sets /api (the Vite dev proxy).
VITE_API_URL=https://roomcraft-api.onrender.com

# Firebase web app config. Print it with:
#   firebase apps:sdkconfig WEB <appId> --project roomcraft-planner
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=roomcraft-planner.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=roomcraft-planner
VITE_FIREBASE_APP_ID=
