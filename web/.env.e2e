# The end-to-end build: Firebase calls go to the local emulators, so nothing
# here reaches a real project. The API is not started; the footer says so.
VITE_API_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-roomcraft.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-roomcraft
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_FIREBASE_EMULATORS=true
