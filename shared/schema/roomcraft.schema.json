{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add",
          "type": "string"
        },
        "placementId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "itemId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "type": "number"
        },
        "reason": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "op",
        "placementId",
        "itemId",
        "x",
        "z",
        "rotation",
        "reason"
      ],
      "title": "AddOperation",
      "type": "object"
    },
    "AssistRequest": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "room": {
          "$ref": "#/$defs/Room"
        },
        "furniture": {
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "maxItems": 100,
          "type": "array"
        },
        "materials": {
          "$ref": "#/$defs/Materials"
        },
        "options": {
          "default": 1,
          "description": "How many alternative layouts.",
          "enum": [
            1,
            3
          ],
          "type": "integer"
        }
      },
      "required": [
        "prompt",
        "room",
        "furniture",
        "materials"
      ],
      "title": "AssistRequest",
      "type": "object"
    },
    "AssistResponse": {
      "additionalProperties": false,
      "properties": {
        "suggestions": {
          "items": {
            "$ref": "#/$defs/Suggestion"
          },
          "type": "array"
        },
        "remainingToday": {
          "type": "integer"
        }
      },
      "required": [
        "suggestions",
        "remainingToday"
      ],
      "title": "AssistResponse",
      "type": "object"
    },
    "CatalogItem": {
      "additionalProperties": false,
      "description": "A piece of furniture that can be placed, built in 3D from its `model` kind.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "model": {
          "$ref": "#/$defs/ModelKind"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 6,
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 6,
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 4,
          "type": "number"
        },
        "elevation": {
          "default": 0,
          "description": "Bottom height for wall items.",
          "maximum": 4,
          "minimum": 0,
          "type": "number"
        },
        "price": {
          "$ref": "#/$defs/PriceRange"
        },
        "color": {
          "pattern": "^#[0-9a-f]{6}$",
          "type": "string"
        },
        "rooms": {
          "description": "Room types it suits.",
          "items": {
            "$ref": "#/$defs/RoomType"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "model",
        "layer",
        "width",
        "depth",
        "height",
        "price",
        "color",
        "rooms"
      ],
      "title": "CatalogItem",
      "type": "object"
    },
    "Category": {
      "enum": [
        "seating",
        "tables",
        "storage",
        "beds",
        "lighting",
        "decor"
      ],
      "type": "string"
    },
    "FloorMaterial": {
      "enum": [
        "wood",
        "tile",
        "carpet"
      ],
      "type": "string"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "description": "Response of `GET /health`.",
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "version"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "Layer": {
      "enum": [
        "floor",
        "rug",
        "wall",
        "ceiling"
      ],
      "type": "string"
    },
    "MaterialOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "material",
          "type": "string"
        },
        "floor": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloorMaterial"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floorColor": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wallColor": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "op",
        "floor",
        "floorColor",
        "wallColor",
        "reason"
      ],
      "title": "MaterialOperation",
      "type": "object"
    },
    "Materials": {
      "additionalProperties": false,
      "description": "The room's finishes: floor material and colour, and wall paint.",
      "properties": {
        "floor": {
          "$ref": "#/$defs/FloorMaterial"
        },
        "floorColor": {
          "pattern": "^#[0-9a-f]{6}$",
          "type": "string"
        },
        "wallColor": {
          "pattern": "^#[0-9a-f]{6}$",
          "type": "string"
        }
      },
      "required": [
        "floor",
        "floorColor",
        "wallColor"
      ],
      "title": "Materials",
      "type": "object"
    },
    "ModelKind": {
      "enum": [
        "sofa",
        "armchair",
        "chair",
        "office_chair",
        "ottoman",
        "table",
        "desk",
        "bed",
        "cabinet",
        "wardrobe",
        "bookshelf",
        "media_unit",
        "floor_lamp",
        "pendant",
        "rug",
        "round_rug",
        "plant",
        "wall_art",
        "mirror",
        "wall_shelf"
      ],
      "type": "string"
    },
    "MoveOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "move",
          "type": "string"
        },
        "placementId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "reason": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "op",
        "placementId",
        "x",
        "z",
        "reason"
      ],
      "title": "MoveOperation",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "description": "A door or window cut into one wall.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OpeningKind"
        },
        "wall": {
          "$ref": "#/$defs/Wall"
        },
        "offset": {
          "description": "From the wall's start to the near edge.",
          "maximum": 20,
          "minimum": 0,
          "type": "number"
        },
        "width": {
          "maximum": 6,
          "minimum": 0.3,
          "type": "number"
        },
        "height": {
          "maximum": 4,
          "minimum": 0.3,
          "type": "number"
        },
        "sill": {
          "description": "Height of the bottom edge; 0 for doors.",
          "maximum": 3,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "wall",
        "offset",
        "width",
        "height",
        "sill"
      ],
      "title": "Opening",
      "type": "object"
    },
    "OpeningKind": {
      "enum": [
        "door",
        "window"
      ],
      "type": "string"
    },
    "Operation": {
      "discriminator": {
        "mapping": {
          "add": "#/$defs/AddOperation",
          "material": "#/$defs/MaterialOperation",
          "move": "#/$defs/MoveOperation",
          "remove": "#/$defs/RemoveOperation",
          "rotate": "#/$defs/RotateOperation"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AddOperation"
        },
        {
          "$ref": "#/$defs/MoveOperation"
        },
        {
          "$ref": "#/$defs/RotateOperation"
        },
        {
          "$ref": "#/$defs/RemoveOperation"
        },
        {
          "$ref": "#/$defs/MaterialOperation"
        }
      ]
    },
    "OperationProblemCode": {
      "enum": [
        "invalid_operation",
        "unknown_item",
        "unknown_placement",
        "outside_room",
        "overlaps",
        "blocks_door",
        "over_budget",
        "fixed_rotation"
      ],
      "type": "string"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "A catalog item placed in the room, positioned by its centre.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "itemId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "x": {
          "description": "West to east, from the room's west wall.",
          "type": "number"
        },
        "z": {
          "description": "North to south, from the room's north wall.",
          "type": "number"
        },
        "rotation": {
          "description": "Degrees.",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "multipleOf": 15,
          "type": "number"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "itemId",
        "x",
        "z",
        "rotation"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PriceRange": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "minimum": 0,
          "type": "number"
        },
        "max": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "PriceRange",
      "type": "object"
    },
    "RejectedOperation": {
      "additionalProperties": false,
      "description": "A proposed change the server refused, and why.",
      "properties": {
        "op": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/OperationProblemCode"
        },
        "otherId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "openingId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "op",
        "reason",
        "code",
        "otherId",
        "openingId"
      ],
      "title": "RejectedOperation",
      "type": "object"
    },
    "RemoveOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "remove",
          "type": "string"
        },
        "placementId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "op",
        "placementId",
        "reason"
      ],
      "title": "RemoveOperation",
      "type": "object"
    },
    "Room": {
      "additionalProperties": false,
      "description": "Room dimensions, openings, style and budget, as set in the setup wizard.",
      "properties": {
        "type": {
          "$ref": "#/$defs/RoomType"
        },
        "width": {
          "description": "West to east, inside the walls.",
          "maximum": 20,
          "minimum": 1.5,
          "type": "number"
        },
        "depth": {
          "description": "North to south, inside the walls.",
          "maximum": 20,
          "minimum": 1.5,
          "type": "number"
        },
        "height": {
          "description": "Floor to ceiling.",
          "maximum": 5,
          "minimum": 2.1,
          "type": "number"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 16,
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "budget": {
          "maximum": 1000000,
          "minimum": 100,
          "type": "number"
        }
      },
      "required": [
        "type",
        "width",
        "depth",
        "height",
        "openings",
        "style",
        "budget"
      ],
      "title": "Room",
      "type": "object"
    },
    "RoomType": {
      "enum": [
        "living_room",
        "bedroom",
        "office",
        "studio"
      ],
      "type": "string"
    },
    "RotateOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "rotate",
          "type": "string"
        },
        "placementId": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "rotation": {
          "type": "number"
        },
        "reason": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "op",
        "placementId",
        "rotation",
        "reason"
      ],
      "title": "RotateOperation",
      "type": "object"
    },
    "Style": {
      "enum": [
        "modern",
        "scandinavian",
        "industrial",
        "classic"
      ],
      "type": "string"
    },
    "Suggestion": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "type": "array"
        },
        "rejected": {
          "items": {
            "$ref": "#/$defs/RejectedOperation"
          },
          "type": "array"
        }
      },
      "required": [
        "summary",
        "operations",
        "rejected"
      ],
      "title": "Suggestion",
      "type": "object"
    },
    "Wall": {
      "enum": [
        "north",
        "east",
        "south",
        "west"
      ],
      "type": "string"
    }
  },
  "title": "Roomcraft shared schema"
}
