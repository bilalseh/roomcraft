# Copy to api/.env to override defaults locally. Every variable is optional.
# In local development the web app reaches the API through the Vite dev proxy,
# so CORS does not apply there.

# JSON list of exact origins allowed to call the API.
# ROOMCRAFT_CORS_ORIGINS=["https://roomcraft-planner.web.app","https://roomcraft-planner.firebaseapp.com"]

# Regex for further allowed origins. Defaults to Firebase Hosting preview channels.
# ROOMCRAFT_CORS_ORIGIN_REGEX=https://roomcraft-planner--[a-z0-9-]+\.web\.app

# Layout assistant. Without a key, POST /v1/assist answers 503.
# ROOMCRAFT_GEMINI_API_KEY=
# ROOMCRAFT_GEMINI_MODEL=gemini-3.8-flash
# ROOMCRAFT_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Service account JSON with the Cloud Datastore User role, for the daily request
# counts in Firestore. On Render it is a secret file under /etc/secrets/.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Requests per person per day, and where to count them. "memory" needs no
# service account and suits local development.
# ROOMCRAFT_DAILY_AI_REQUESTS=20
# ROOMCRAFT_RATE_LIMIT_STORE=memory
